grammar Stlc

import ast.rules
import stlc.gen.StlcParser
import stlc.gen.StlcParser.*
import stlc.gen.StlcLexer
import stlc.gen.StlcLexer.*
import org.fancryer.bf.ast.*

default
  println("default for ${it::class.simpleName}");
  "TODO".id.call(KLineStringLiteral(emptyList()).valueArg.args)

rX X, KSimpleIdentifier ctx ::= ctx.ID().text.id

rVariable Variable, KSimpleIdentifier ctx ::= rX(ctx.x())

rTrue `true` Constant_true, EBooleanLiteral _ ::= true.ast
rFalse `false` Constant_false, EBooleanLiteral _ ::= false.ast

rParenthesis parenthesis Parenthesis, KParenthesizedExpression ctx ::=
  val tToExp = |?TContext KExpression?| ?? ()
    ?: "ASTra doesn't know how to get KExpression from Parenthesis".err;
  tToExp(ctx.t()).paren

rConditional conditional Conditional, KIfExpression ctx ::=
  val tToExp = |?TContext KExpression?|
    ?: "ASTra doesn't know how to get KExpression from T".err;
  tToExp(ctx.pred).ifElse(
    tToExp(ctx.if_true).block,
    tToExp(ctx.if_false).block
  )

rT t T, KExpression ctx ::=
  match ctx to
  |: VariableContext -> rVariable(ctx)
  |: AbstractionContext ->
    |?AbstractionContext KFunctionLiteral?| ?? ctx
      ?: "ASTra doesn't know how to get KLambdaLiteral from Abstraction".err

  |: ApplicationContext ->
    |?ApplicationContext KExpression?| ?? ctx
      ?: "ASTra doesn't know how to get KExpression from ApplicationContext".err

  |: Constant_trueContext -> rTrue(ctx)
  |: Constant_falseContext -> rFalse(ctx)
  |: ConditionalContext -> rConditional(ctx)
  |: ParenthesisContext -> rParenthesis(ctx)
  | _ -> "ASTra doesn't know how to get KExpression from ${ctx::class.simpleName}".err

rApplication application Application, KExpression ctx ::=
  val exp=ctx.t(1);
  ctx.t(0).let(rT)
    .castOr<KExpression,KPrimaryExpression> ({it.paren})
    .call(rT(exp).valueArg.args)

rType type Type, KType ctx rType<|>
  val boolify={name: String ->
    if(name=="Bool") "Boolean" else name
  };
  match ctx to
  |: Flat_typeContext -> boolify(ctx.ID().text).type
  |: Abstraction_typeContext ->
      boolify(ctx.ID().text).type
        .functionTypeParameters
        .leadsTo(rType(ctx.type()))
        .type
  | _ -> "ASTra doesn't know how to get other KType from ${ctx::class.simpleName}".err

rAbstraction Abstraction, KLambdaLiteral ctx ::=
  rX(ctx.x()).variableDecl(rType(ctx.type()))
    .lambdaParams
    .literal(rT(ctx.t()).stat)