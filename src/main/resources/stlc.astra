rule<ApplicationContext,KPostfixUnaryExpression>("application") {
	from(ApplicationContext::class)
	how {ctx->
		val callee=mapWithOrThrow<TermContext,KPrimaryExpression>({it.how(ctx.term(0))}) {
			Exception("No expression for ${ctx.sourcify}")
		}
		val arg=mapWithOrThrow<TermContext,KExpression>({it.how(ctx.term(1))}) {
			Exception("No expression for ${ctx.sourcify}")
		}
		callee.call(arg.valueArg.nonEmptyList())
	}
}

rule<ParenthesisContext,KParenthesizedExpression>("paren") {
	from(ParenthesisContext::class)
	how {ctx->
		lookup<TermContext,KExpression>()?.how
			?.let {it(ctx.term())}
			?.paren
		?: throw Exception("No expression for ${ctx.sourcify}")
	}
}