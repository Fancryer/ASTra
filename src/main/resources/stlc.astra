rule variable :: VariableContext -> KPrimaryExpression
variable ctx = `ctx.Id().text.id`;

rule flatType :: FlatContext -> KUserType
flatType ctx = `KUserType(KSimpleUserType(ctx.Type().text.id,none()).nonEmptyList())`;

rule true_constant :: Constant_trueContext -> EBooleanLiteral
true_constant _ = `EBooleanLiteral.True`;

rule false_constant :: Constant_falseContext -> EBooleanLiteral
false_constant _ = `EBooleanLiteral.False`;

funct termToType :: Token -> KType
termToType t = `KUserType(KSimpleUserType(t.text.id,none()).nonEmptyList()).type`;

rule funType :: FunContext -> KFunctionType
funType ctx =
	let i = `termToType(ctx.\`in\`)` in
	let o = `termToType(ctx.\`out\`)` in
    `KFunctionType(
        none(),
        KFunctionTypeParameters(
            #{i}.nonEmptyList()
        ),
        #{o}
    )`

rule<FunContext,KFunctionType>("funType") {
	from(FunContext::class)
	how {ctx:FunContext->
		val termToType={t:Token->
			KUserType(
				KSimpleUserType(t.text.id,none()).nonEmptyList()
			).type
		}
		KFunctionType(
			none(),
			KFunctionTypeParameters(
				termToType(ctx.`in`).nonEmptyList()
			),
			termToType(ctx.`out`)
		)
	}
}

